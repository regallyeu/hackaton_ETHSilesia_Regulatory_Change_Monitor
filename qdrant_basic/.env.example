# Qdrant (docker-compose exposes 6333)
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=qdrant_basic

# OpenAI-compatible embeddings (default: official OpenAI API)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# Optional: short answer built from retrieved chunks (same key / base URL)
CHAT_MODEL=gpt-4o-mini

# Chunking (characters per chunk, non-overlapping)
CHUNK_CHARS=800
